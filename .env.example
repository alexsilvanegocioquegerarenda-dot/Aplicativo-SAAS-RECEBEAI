# ==============================================================================
# RECEBEAI - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Renomeie ou copie este arquivo para .env na raiz do projeto.
# Se estas variáveis não forem preenchidas, o aplicativo entrará automaticamente
# em Modo Local / Demonstração (persistido no navegador).

# URL da sua instância Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (anon key) do Supabase (Project Settings > API)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
